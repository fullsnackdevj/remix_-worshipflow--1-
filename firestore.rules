rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /chat_channels/{channelId}/messages/{msgId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
    match /events/{eventId}/registrants/{registrantId} {
      allow get:    if request.auth != null;
      allow list:   if true;
      allow create: if true;
      allow update: if request.auth != null;
    }
    match /events/{eventId}/contributions/{memberId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    match /users/{userId}/bibleCollection/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/bibleDevotions/{devotionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /wfPlaylists/{playlistId} {
      allow read, write: if request.auth != null;
    }

    match /sharedPlaylists/{slug} {
      allow read:  if true;
      allow write: if false;
    }

    match /live_state/{doc} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Media Library — auth users read/write, OBS can read (no auth) ──────────
    match /media_library/{itemId} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}