# ── Server-side (Netlify Functions + local server.ts) ────────────────────────
# Firebase Admin SDK — get from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""          # paste the full key; \n will be converted automatically
FIREBASE_STORAGE_BUCKET=""       # e.g. your-project.appspot.com

# AI / OCR
GEMINI_API_KEY=""

# Email notifications
RESEND_API_KEY=""
APP_URL=""                       # base URL for email links e.g. https://worshipflow.netlify.app

# ── Client-side (Vite build — baked into the browser bundle) ─────────────────
# Firebase Web SDK — get from Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Web Push notifications (VAPID) — get from Firebase Console → Cloud Messaging
VITE_VAPID_KEY=""
