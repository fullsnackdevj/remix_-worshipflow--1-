rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Proof of payment images — public registrants can upload ───────────────
    match /events/{eventId}/proofs/{filename} {
      allow read:  if true;
      allow write: if true;   // no login needed — public registration flow
    }

    // ── QR images uploaded by admin ──────────────────────────────────────────
    match /events/{fileName} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Live Stage background videos — uploaded by admin, read by OBS ────────
    // OBS Browser Source has no auth session, so reads must be public.
    // Writes require admin login (admin is always authenticated).
    match /live-bg-videos/{filename} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Live Stage fade screen image/video — uploaded by admin, read by OBS ────
    // OBS Browser Source has no auth session, so reads must be public.
    match /live-fade-bg/{filename} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Media Library — uploaded by admin, thumbnails & URLs read by the app ──
    // Items in this path have Firebase Storage download tokens in their URLs,
    // which bypass auth checks. Adding an explicit rule ensures reads are
    // consistent regardless of token state and eliminates any auth edge cases.
    match /media_library/{filename} {
      allow read:  if true;
      allow write: if request.auth != null;
    }

    // ── Preaching share request attachments — guest preachers upload via share link ──
    match /preaching_shares/{shareId}/{filename} {
      allow read:  if true;   // designer needs to download/preview the file
      allow write: if true;   // no login needed — public share-link flow
    }


    // ── All other paths: require authentication ───────────────────────────────
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

  }
}
